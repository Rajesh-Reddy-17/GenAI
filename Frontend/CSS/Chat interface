
html, body {
    height: 100%;
}

body {
    height: 100dvh;
}

.container {
    height: 100%;
}

.chat-box {
    flex: 1;
    min-height: 0;
}

#chat {
    flex: 1;
    height: auto;
    min-height: 0;
}


.input-row {
    align-items: center;
    padding: 6px 6px 6px 12px;
    border-radius: 999px;
}

#message {
    min-width: 0;
}

#attach-btn,
#mic-btn {
    background: transparent;
    color: var(--muted);
    width: 36px;
    height: 36px;
    min-width: 36px;
    padding: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    flex-shrink: 0;
}

#attach-btn:hover,
#mic-btn:hover {
    background: var(--border);
    color: var(--text);
    filter: none;
    box-shadow: none;
    transform: none;
}

#mic-btn.listening {
    background: #FF4A4A;
    color: #fff;
    animation: micPulse 1.2s ease-in-out infinite;
}

@keyframes micPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 74, 74, 0.5); }
    50% { box-shadow: 0 0 0 8px rgba(255, 74, 74, 0); }
}

#send-btn {
    width: 38px;
    height: 38px;
    min-width: 38px;
    padding: 0;
    border-radius: 50%;
    background: #fff;
    color: #0B0D12;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

#send-btn:hover {
    filter: brightness(0.94);
    box-shadow: none;
    transform: none;
}

#send-btn.generating {
    background: #fff;
}

#send-icon.hidden,
#stop-icon.hidden {
    display: none;
}
